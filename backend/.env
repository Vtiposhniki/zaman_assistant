# ====== ZAMAN ASSISTANT CONFIG TEMPLATE ======
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# ========================================
# 🔑 OPENAI HUB (NeuralDeep)
# ========================================
# Get your key at: https://openai-hub.neuraldeep.tech/
OPENAI_HUB_URL=https://openai-hub.neuraldeep.tech
OPENAI_HUB_KEY=your_api_key_here

# Models
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# Timeouts
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3

# ========================================
# 💾 DATABASE
# ========================================
# Development (SQLite)
DATABASE_URL=sqlite:///./zaman_assistant.db

# Production (PostgreSQL) - recommended
# DATABASE_URL=postgresql://user:password@postgres:5432/zaman_db

# ========================================
# 🔐 SECURITY
# ========================================
# Generate strong token: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=CHANGE_ME_TO_RANDOM_STRING

# JWT Secret (generate with same command)
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ========================================
# ⚡ PERFORMANCE
# ========================================
CACHE_TTL_SECONDS=3600
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=3600

# ========================================
# 🎭 MODE
# ========================================
MOCK_MODE=false
DEBUG=false
LOG_LEVEL=INFO

# ========================================
# 🎤 WHISPER
# ========================================
WHISPER_ENABLED=true
WHISPER_DEFAULT_LANGUAGE=ru
WHISPER_MAX_FILE_SIZE_MB=25

# ========================================
# 📊 MONITORING (Optional)
# ========================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# PROMETHEUS_PORT=9090