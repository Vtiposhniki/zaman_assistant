# ====== ZAMAN ASSISTANT CONFIG (Production Ready) ======

# ========================================
# 🎭 MODE
# ========================================
# true = моки (для разработки), false = реальные API вызовы
MOCK_MODE=false
DEBUG=false


# ========================================
# 🔑 OPENAI HUB (NeuralDeep)
# ========================================
# URL хаба (без trailing slash)
OPENAI_HUB_URL=https://openai-hub.neuraldeep.tech

# API ключ (получите на https://openai-hub.neuraldeep.tech/)
OPENAI_HUB_KEY=sk-roG3OusRr0TLCHAADks6lw

# Модели (можно менять на gpt-4o, gpt-3.5-turbo и т.д.)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# Таймауты и retry
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3

# Circuit Breaker
OPENAI_MAX_FAILURES=5
OPENAI_CIRCUIT_TIMEOUT_SECONDS=60


# ========================================
# 💾 DATABASE
# ========================================
# Development
DATABASE_URL=sqlite:///./zaman_assistant.db

# Production (PostgreSQL) - раскомментируйте
# DATABASE_URL=postgresql://user:password@localhost:5432/zaman_db


# ========================================
# 🔐 SECURITY
# ========================================
# Админ токен (ОБЯЗАТЕЛЬНО измените!)
ADMIN_TOKEN=supersecret

# CORS origins (для production)
# CORS_ORIGINS=https://zamanbank.kz,https://app.zamanbank.kz


# ========================================
# ⚡ PERFORMANCE
# ========================================
# Cache TTL
CACHE_TTL_SECONDS=3600

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=3600

# Embeddings
EMBEDDINGS_PATH=./data/product_embeddings.pkl
EMBED_DIM=1536


# ========================================
# 🌐 SERVER
# ========================================
PORT=8000
HOST=0.0.0.0


# ========================================
# 📊 MONITORING (опционально)
# ========================================
# Log level
LOG_LEVEL=INFO

# Sentry DSN (для error tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id


# ========================================
# 📝 NOTES
# ========================================
# 1. Никогда не коммитьте .env с реальными ключами!
# 2. Используйте разные ключи для dev/staging/production
# 3. Регулярно ротируйте ADMIN_TOKEN
# 4. В production: MOCK_MODE=false, DEBUG=false
# ========================================
# 🎤 WHISPER AUDIO
# ========================================
# Включить обработку аудио
WHISPER_ENABLED=true

# Языки по умолчанию для транскрибирования
WHISPER_DEFAULT_LANGUAGE=ru

# Максимальный размер аудио файла (в MB)
WHISPER_MAX_FILE_SIZE_MB=25

# Поддерживаемые форматы (через запятую)
WHISPER_FORMATS=mp3,wav,m4a,flac,ogg,webm

# Timeout для Whisper запросов (в секундах)
WHISPER_TIMEOUT_SECONDS=300