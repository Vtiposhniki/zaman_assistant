# ====== ZAMAN ASSISTANT CONFIGURATION ======

# ========================================
# 🔑 API KEYS
# ========================================

# OpenAI Hub API (для production)
OPENAI_HUB_KEY=sk-your-api-key-here
OPENAI_HUB_URL=https://openai-hub.neuraldeep.tech

# Admin token для защищённых endpoints
# ВАЖНО: Измените в production!
ADMIN_TOKEN=change-me-in-production


# ========================================
# 💾 DATABASE
# ========================================

# Development (SQLite)
DATABASE_URL=sqlite:///./zaman_assistant.db

# Production (PostgreSQL) - раскомментируйте для использования
# DATABASE_URL=postgresql://username:password@localhost:5432/zaman_db

# Production (PostgreSQL with connection pooling)
# DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/zaman_db?pool_size=20&max_overflow=10


# ========================================
# 🎭 MODES
# ========================================

# Тестовый режим (без реальных LLM вызовов)
# true = моки, false = реальные API вызовы
MOCK_MODE=false

# Debug режим (auto-reload при изменениях)
# true = включен, false = выключен (для production)
DEBUG=true


# ========================================
# ⚡ PERFORMANCE
# ========================================

# Cache TTL (время жизни кэша в секундах)
CACHE_TTL_SECONDS=3600

# Rate Limiting (максимум запросов / окно времени)
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=3600


# ========================================
# 🔍 EMBEDDINGS
# ========================================

# Путь к файлу с embeddings
EMBEDDINGS_PATH=./data/product_embeddings.pkl

# Размерность векторов
EMBED_DIM=1536


# ========================================
# 🌐 SERVER
# ========================================

# Порт сервера (по умолчанию 8000)
PORT=8000

# Host (0.0.0.0 для доступа извне)
HOST=0.0.0.0


# ========================================
# 📊 MONITORING (опционально)
# ========================================

# Sentry DSN для error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log format (json для production)
# LOG_FORMAT=json


# ========================================
# 🔐 SECURITY (production)
# ========================================

# Allowed CORS origins (разделённые запятыми)
# CORS_ORIGINS=https://zamanbank.kz,https://app.zamanbank.kz

# JWT secret (если добавите authentication)
# JWT_SECRET=your-super-secret-jwt-key
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_HOURS=24


# ========================================
# 📧 NOTIFICATIONS (опционально)
# ========================================

# Email для уведомлений
# ADMIN_EMAIL=admin@zamanbank.kz

# SMTP настройки
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@zamanbank.kz
# SMTP_PASSWORD=your-smtp-password


# ========================================
# 🎯 BUSINESS LOGIC
# ========================================

# Минимальная сумма для целей (KZT)
MIN_GOAL_AMOUNT=10000

# Максимальная сумма для целей (KZT)
MAX_GOAL_AMOUNT=100000000

# Максимальный срок цели (месяцы)
MAX_GOAL_MONTHS=360


# ========================================
# 🧪 TESTING
# ========================================

# Test database (для тестов)
# TEST_DATABASE_URL=sqlite:///./test_zaman_assistant.db

# Disable rate limiting in tests
# TEST_DISABLE_RATE_LIMIT=true


# ========================================
# 📝 NOTES
# ========================================

# 1. Никогда не коммитьте этот файл с реальными ключами!
# 2. Добавьте .env в .gitignore
# 3. Используйте разные токены для dev/staging/production
# 4. В production установите MOCK_MODE=false
# 5. В production установите DEBUG=false
# 6. Регулярно ротируйте ADMIN_TOKEN