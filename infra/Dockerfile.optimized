# ===== OPTIMIZED MULTI-STAGE DOCKER BUILD =====
# Enhanced Dockerfile with security, performance, and size optimizations

# ===== STAGE 1: Base Image =====
FROM python:3.11-slim-bookworm AS base

# Security: Create non-root user early
RUN groupadd -r zaman && useradd -r -g zaman zaman

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set timezone
ENV TZ=Asia/Almaty
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# ===== STAGE 2: Builder =====
FROM base AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies with optimizations
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --no-deps -r requirements.txt && \
    pip install --no-cache-dir --no-deps --upgrade pip setuptools wheel

# ===== STAGE 3: Security Scanner =====
FROM builder AS security-scanner

# Install security tools
RUN pip install --no-cache-dir bandit safety

# Copy source code
COPY backend/ /app/backend/

# Run security scans
RUN bandit -r /app/backend/ -f json -o /tmp/bandit-report.json || true
RUN safety check --json --output /tmp/safety-report.json || true

# ===== STAGE 4: Runtime =====
FROM base AS runtime

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=Asia/Almaty

# Create application directory
WORKDIR /app

# Copy application code
COPY backend/ /app/backend/
COPY backend/products.json /app/
COPY requirements.txt /app/

# Create necessary directories with proper permissions
RUN mkdir -p /app/data /app/logs /app/tmp && \
    chown -R zaman:zaman /app

# Switch to non-root user
USER zaman

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Start command
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]

# ===== STAGE 5: Production =====
FROM runtime AS production

# Add production-specific configurations
ENV ENVIRONMENT=production \
    LOG_LEVEL=INFO \
    WORKERS=4

# Copy production configuration
COPY infra/production.conf /app/

# ===== STAGE 6: Development =====
FROM runtime AS development

# Add development-specific configurations
ENV ENVIRONMENT=development \
    LOG_LEVEL=DEBUG \
    WORKERS=1

# Install development dependencies
USER root
RUN pip install --no-cache-dir pytest pytest-asyncio pytest-cov
USER zaman

# Copy development configuration
COPY infra/development.conf /app/
